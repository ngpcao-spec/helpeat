# Export these to the shell for isolated real-mode builds. GitHub Pages fixes this flag to false.
VITE_HELPEAT_ENABLE_REAL=false
VITE_HELPEAT_SUPABASE_PUBLISHABLE_KEY=

# Server-side legacy connector settings. Vite does not load these.
HOME_AI_BRIDGE_URL=
HELPEAT_BRIDGE_SECRET=
HELPEAT_PHOTO_ENABLED=false
